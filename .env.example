# 3D Portrait Studio — environment variables
# Copy to .env.local for development. Never commit real values.
# Variables prefixed NEXT_PUBLIC_ are exposed to the browser; everything else is server-only.

# ── App ──────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Origin serving public embeds (can equal APP_URL)
NEXT_PUBLIC_EMBED_URL=http://localhost:3000

# ── Supabase (Auth, Postgres, private photo storage) ────────────────
# Project settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Bypasses RLS — use only in trusted server code.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_SOURCE_IMAGES_BUCKET=source-images

# ── Cloudflare R2 (generated models, exports, published embeds) ─────
# R2 → Manage API tokens (Object Read & Write, scoped to the buckets below)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PRIVATE_BUCKET=portrait-assets
R2_PUBLIC_BUCKET=portrait-embeds
# Custom domain bound to the public bucket, e.g. https://cdn.example.com
R2_PUBLIC_BASE_URL=

# ── AI reconstruction ────────────────────────────────────────────────
# Provider id resolved by lib/reconstruction/registry. Chosen after the
# Milestone 6 evaluation. "fixture" is development-only and refused in production.
RECONSTRUCTION_PROVIDER=fixture
# Provider credentials (added once a provider is selected)
RECONSTRUCTION_API_KEY=
RECONSTRUCTION_WEBHOOK_SECRET=

# ── Background work ──────────────────────────────────────────────────
# Shared secret Vercel Cron sends as Authorization: Bearer <CRON_SECRET>
CRON_SECRET=
