# 3D Portrait Studio — environment variables
# Copy to .env.local for development. Never commit real values.
# Variables prefixed NEXT_PUBLIC_ are exposed to the browser; everything else is server-only.

# ── App ──────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Origin serving public embeds (can equal APP_URL)
NEXT_PUBLIC_EMBED_URL=http://localhost:3000

# ── Supabase (Auth, Postgres, private photo storage) ────────────────
# Project settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Bypasses RLS — use only in trusted server code.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_SOURCE_IMAGES_BUCKET=source-images

# ── Cloudflare R2 (generated models, exports, published embeds) ─────
# R2 → Manage API tokens (Object Read & Write, scoped to the buckets below)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PRIVATE_BUCKET=portrait-assets
R2_PUBLIC_BUCKET=portrait-embeds
# Custom domain bound to the public bucket, e.g. https://cdn.example.com
R2_PUBLIC_BASE_URL=

# ── Local development backend (Milestone 6) ─────────────────────────
# Accounts, photos and models stored on this machine under DATA_DIR. For
# development and tests only; refused on hosted deployments (VERCEL set).
LOCAL_BACKEND=1
DATA_DIR=.data

# ── AI reconstruction ────────────────────────────────────────────────
# "fixture": development provider — no external call, returns bundled CC0
#            models after the real pipeline steps (refused on hosted deployments).
# "meshy":   Meshy Multi-Image to 3D adapter (docs/research/provider-comparison.md).
RECONSTRUCTION_PROVIDER=fixture
# Fixture timing (ms) and provider polling interval (ms).
FIXTURE_DURATION_MS=9000
RECONSTRUCTION_POLL_MS=2000
# Server-only provider key. An external provider stays OFF unless this is set
# AND RECONSTRUCTION_PROVIDER_APPROVED=1 (product-owner approval of spending).
RECONSTRUCTION_API_KEY=
RECONSTRUCTION_PROVIDER_APPROVED=
RECONSTRUCTION_WEBHOOK_SECRET=

# ── Background work ──────────────────────────────────────────────────
# Shared secret Vercel Cron sends as Authorization: Bearer <CRON_SECRET>
CRON_SECRET=

# ── Regions ──────────────────────────────────────────────────────────
# Comma-separated ISO 3166-1 alpha-2 codes where production image processing is
# enabled, after provider, licensing and privacy review (ADR 0002). Empty = none.
PROCESSING_ENABLED_REGIONS=
