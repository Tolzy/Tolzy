    "grammar": [
      {
        "id": "aller-infinitive",
        "title": "Aller + infinitive",
        "pattern": "aller (présent) + infinitive",
        "excerpt": "Je vais vous montrer…",
        "cefr": "A1",
        "explanation": {
          "a1": "Used for the near future. Je vais montrer = I'm going to show. It works just like 'going to' in English.",
          "a2": "Used for the near future: conjugate aller, then add a verb in its basic form. Je vais faire, on va couper.",
          "b1": "The futur proche is the everyday way to talk about plans. The futur simple (je montrerai) sounds more formal or distant.",
          "b2": "Le futur proche (aller + infinitif) exprime une action imminente ou prévue. Plus courant à l'oral que le futur simple."
        },
        "examples": [
          "Je vais manger.",
          "On va partir.",
          "Tu vas aimer ça."
        ]
      },
      {
        "id": "pronoun-before-infinitive",
        "title": "Pronoun before the infinitive",
        "pattern": "aller + pronoun + infinitive",
        "excerpt": "je vais vous montrer",
        "cefr": "A2",
        "explanation": {
          "a1": "Vous (you) goes before montrer: je vais vous montrer = I'm going to show you.",
          "a2": "The small word vous comes before the verb it belongs to (montrer), not after it like in English.",
          "b1": "Object pronouns attach to the infinitive they complement: je vais le faire, on va leur dire.",
          "b2": "Le pronom complément se place devant l'infinitif dont il dépend : « je vais vous montrer »."
        },
        "examples": [
          "Je vais te montrer.",
          "On va le faire."
        ]
      },
      {
        "id": "partitive",
        "title": "Du / des: some",
        "pattern": "du / de la / des + noun",
        "excerpt": "du café… des fruits",
        "cefr": "A1",
        "explanation": {
          "a1": "Du café = some coffee. Des fruits = some fruit. French needs this little word; English often doesn't.",
          "a2": "Use du (masculine), de la (feminine) or des (plural) for an unspecified amount.",
          "b1": "After a negative, du/de la/des become de: je ne bois pas de café.",
          "b2": "L'article partitif exprime une quantité indéterminée ; il devient « de » après une négation."
        },
        "examples": [
          "Je bois du thé.",
          "Elle mange des fruits."
        ]
      }
    ],
