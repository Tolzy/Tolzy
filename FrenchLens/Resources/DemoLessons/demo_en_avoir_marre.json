    "grammar": [
      {
        "id": "marre-de-infinitive",
        "title": "De + infinitive",
        "pattern": "en avoir marre de + infinitive",
        "excerpt": "J'en ai marre de travailler",
        "cefr": "A2",
        "explanation": {
          "a1": "After en avoir marre de, put a verb in its basic form (the infinitive). Travailler = to work.",
          "a2": "After en avoir marre de, use the infinitive. English says 'fed up with working'; French says 'fed up of to work'.",
          "b1": "Many French expressions take de + infinitive where English uses -ing: arrêter de fumer, essayer de dormir.",
          "b2": "Après « en avoir marre de », le verbe est à l'infinitif. Même construction : arrêter de, essayer de, oublier de."
        },
        "examples": [
          "J'en ai marre d'attendre.",
          "J'en ai marre de cuisiner."
        ]
