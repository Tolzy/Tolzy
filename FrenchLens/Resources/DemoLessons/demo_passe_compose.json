    "grammar": [
      {
        "id": "pc-avoir",
        "title": "Passé composé with avoir",
        "pattern": "avoir (présent) + past participle",
        "excerpt": "J'ai acheté… on a mangé",
        "cefr": "A2",
        "explanation": {
          "a1": "To say what you did, use avoir + the past form of the verb. J'ai acheté = I bought.",
          "a2": "Avoir + past participle. -er verbs end in -é: acheter → acheté, manger → mangé.",
          "b1": "Most verbs form the passé composé with avoir. The participle doesn't agree with the subject.",
          "b2": "La majorité des verbes forment le passé composé avec « avoir » ; le participe ne s'accorde pas avec le sujet."
        },
        "examples": [
          "J'ai mangé une pomme.",
          "Tu as acheté du pain ?"
        ]
      },
      {
        "id": "pc-etre",
        "title": "Passé composé with être",
        "pattern": "être (présent) + past participle",
        "excerpt": "je suis allé",
        "cefr": "A2",
        "explanation": {
          "a1": "Some verbs, like aller, use être instead: je suis allé = I went.",
          "a2": "Aller, venir, partir, arriver, rester… use être. Je suis allé (man), je suis allée (woman).",
          "b1": "With être, the participle agrees with the subject in gender and number: elles sont allées.",
          "b2": "Avec « être », le participe passé s'accorde avec le sujet : « elles sont allées »."
        },
        "examples": [
          "Elle est allée à Paris.",
          "Nous sommes partis tôt."
        ]
      }
    ],
