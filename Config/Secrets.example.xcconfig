// Copy to Config/Secrets.xcconfig (git-ignored) and fill in.
// Never put AI provider API keys here: the iOS client only knows the
// FrenchLens backend URL. Provider keys live on the server.

// DEVELOPMENT_TEAM = ABCDE12345
// FRENCHLENS_BUNDLE_ID_PREFIX = com.yourcompany
// FRENCHLENS_API_BASE_URL = https:/$()/api.frenchlens.example
